# Local File Hub 环境变量示例
# 复制为 .env 后，请替换管理员密码和实际部署路径。

# 运行环境与网络
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# 数据目录。DB_PATH、OBJECT_DIR 和 UPLOAD_DIR 未设置时会自动使用 DATA_DIR 下的子目录。
DATA_DIR=./data
# DB_PATH=./data/db/local-file-hub.sqlite
# OBJECT_DIR=./data/objects
# UPLOAD_DIR=./data/uploads

# 生产前端构建目录；运行 npm run start 前必须先执行 npm run build。
# WEB_DIST_DIR=./dist/web

# 当前保留配置，现有代码未使用它生成 URL。
# PUBLIC_URL=http://localhost:3000

# 首次启动管理员账号。
# 生产环境必须显式设置 ADMIN_USERNAME 和 ADMIN_PASSWORD；
# ADMIN_PASSWORD 至少 12 个字节，修改已有管理员的环境变量不会覆盖数据库中的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 单个上传文件的最大字节数，默认 1 GiB。
MAX_UPLOAD_BYTES=1073741824

# 会话有效期（小时）。
SESSION_TTL_HOURS=24

# Cookie 安全选项。开发环境可使用 false；通过 HTTPS 反向代理访问时应设为 true。
COOKIE_SECURE=false

# 反向代理信任配置。
# 可设为 false、true、代理跳数（例如 1）或 Fastify 支持的代理地址字符串。
TRUST_PROXY=false

# pino 日志级别：fatal、error、warn、info、debug、trace 或 silent。
LOG_LEVEL=info
# 可选日志文件；设置后会自动创建父目录。
# LOG_FILE=./logs/local-file-hub.log
