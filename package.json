{
  "name": "local-file-hub",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "scripts\\node22.cmd node_modules/tsx/dist/cli.mjs watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start": "scripts\\node22.cmd dist/apps/server/src/index.js",
    "backup": "scripts\\node22.cmd node_modules/tsx/dist/cli.mjs scripts/backup.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc --noEmit -p apps/server/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "scripts\\node22.cmd node_modules/vitest/vitest.mjs run",
    "test:watch": "scripts\\node22.cmd node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.102.8",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.4",
    "lucide-react": "^1.45.0",
    "markdown-it": "^15.0.2",
    "mime-types": "^2.1.35",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
